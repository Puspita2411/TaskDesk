# Copy this file to ".env" (same folder) and fill in the real values.
# Ask the project owner for the real MONGO_URI and JWT_SECRET. Never commit ".env".
PORT=5000
MONGO_URI=mongodb+srv://<db_user>:<db_password>@<cluster-address>.mongodb.net/taskdesk?retryWrites=true&w=majority&appName=TaskDesk
JWT_SECRET=replace-with-a-long-random-text
